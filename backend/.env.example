# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ===== Bán hàng / thanh toán =====
# URL công khai của giao diện web (dùng để chuyển hướng sau khi thanh toán)
APP_URL="http://localhost:5173"
# URL công khai của backend (VNPay gọi về địa chỉ này)
API_URL="http://localhost:3000"
# Bắt buộc khi chạy production: chuỗi ngẫu nhiên dài để ký token đăng nhập
JWT_SECRET=""
# Tài khoản quản trị tạo ở lần chạy đầu. Nếu để trống mật khẩu, hệ thống tự sinh và in ra console.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_EMAIL=""
# mock = cổng thanh toán giả lập (chỉ dùng khi phát triển) | vnpay = VNPay
PAYMENT_PROVIDER="mock"
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_PAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
# Hạn mức AI mỗi người mỗi ngày
AI_LIMIT_FREE=10
AI_LIMIT_PAID=60
AI_LIMIT_PREMIUM=300
TTS_LIMIT_DAILY=300
SUPPORT_EMAIL="support@example.com"
SUPPORT_PHONE=""
