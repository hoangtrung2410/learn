{
  "name": "linguapulse-backend",
  "version": "1.0.0",
  "description": "LinguaPulse backend API (NestJS + Google Gemini)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/main.ts",
    "start": "node node_modules/tsx/dist/cli.mjs src/main.ts",
    "build": "node node_modules/esbuild/bin/esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/main.js --packages=external",
    "start:prod": "node dist/main.js",
    "lint": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
